# Copia este archivo a .env y completa los valores. NO subas .env a Git.
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Máximo por archivo subido (MB). Las imágenes grandes se redimensionan después (módulo 5).
MAX_UPLOAD_MB=25

# Dataset: carpeta con capturas.json, catalogo_productos.csv e imagenes/
DATA_DIR=./data
CAPTURAS_FILE=capturas.json
CATALOGO_FILE=catalogo_productos.csv

# Azure AI Foundry (sin llave/endpoint, toda validación sale como revision_manual)
FOUNDRY_API_KEY=
FOUNDRY_ENDPOINT=https://softwaredevelopment-resource.services.ai.azure.com/anthropic
FOUNDRY_MODEL=claude-haiku-5-5
FOUNDRY_TIMEOUT_MS=60000
FOUNDRY_REINTENTOS=2
MAX_TOKENS_SALIDA=500

# Imágenes que se envían al modelo (las originales no se modifican)
IMG_LADO_LARGO=1024
IMG_LADO_CORTO=768
IMG_CALIDAD_JPEG=85
# Lectura local de código de barras y umbral de fotos duplicadas (distancia de Hamming del dHash)
LEER_CODIGOS=true
DUP_UMBRAL_HAMMING=4

# Reglas deterministas: precio leído ≠ capturado → revision | ignorar
REGLA_PRECIO_DISCREPANCIA=revision
PRECIO_TOLERANCIA=0.01
